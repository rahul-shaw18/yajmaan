# Django Configuration
SECRET_KEY=django-insecure-yajaman-vendor-booking-dev-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*

# Database: Default is SQLite. For Supabase / PostgreSQL, set DATABASE_URL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///db.sqlite3

# Fast2SMS API Key (https://www.fast2sms.com)
# Get your API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Firebase Cloud Messaging
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_PATH=

# JWT Token Settings
ACCESS_TOKEN_LIFETIME_DAYS=7
REFRESH_TOKEN_LIFETIME_DAYS=30

# Dev/Testing Phone OTP (Optional: if set, fixes OTP to this code; leave empty to send real random SMS OTPs)
DEV_MOCK_OTP=

# Google Gemini API Key for dynamic AI horoscope generation
GEMINI_API_KEY=your_gemini_api_key_here
